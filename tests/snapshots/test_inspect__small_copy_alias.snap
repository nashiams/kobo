#[derive(Clone, Copy)]
struct SmallCopy {
    a: u64,
    b: u64,
}
fn main() {
    let x = SmallCopy { a: 1, b: 2 };
    let y = x.clone();
// kobo: sum @ line 10 -> plain (local-only non-Copy binding)
    let sum = x.a + y.b;
    println!("{}", sum);
}
