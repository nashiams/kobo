use std::cell::RefCell;
use std::rc::Rc;
fn main() {
// kobo: x @ line 2 -> rc_refcell (mutable shared, last resort)
    let x = Rc::new(RefCell::new(vec![1]));
// kobo: r @ line 3 -> borrow-scope-conservative
    let r = &mut *x.borrow_mut();
    r.iter_mut().for_each(|value| *value += 1);
    println!("{}", r[0]);
}
