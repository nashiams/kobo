use std::cell::RefCell;
use std::rc::Rc;
fn main() {
// kobo: names @ line 2 -> rc_refcell (non-Copy shared binding)
    let names = Rc::new(RefCell::new(vec!["alice", "bob"]));
    let count = 2;
    let _count_copy = count;
// kobo: greeting @ line 5 -> rc_refcell (non-Copy shared binding)
    let greeting = Rc::new(RefCell::new(greet(names.clone())));
    println!("{}", greeting.borrow());
}
// kobo: names @ line 9 -> rc_refcell (non-Copy shared binding)
fn greet(names: Rc<RefCell<Vec<&str>>>) -> String {
    names.borrow().join(", ")
}
